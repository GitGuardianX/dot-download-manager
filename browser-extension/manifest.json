{
  "manifest_version": 3,
  "name": "DOT Download Manager",
  "version": "0.4.7",
  "description": "Send browser downloads and videos to DOT. Nothing runs until you download or play something.",
  "minimum_chrome_version": "120",
  "permissions": ["downloads", "storage", "contextMenus", "cookies", "webRequest"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "worker.js"},
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "all_frames": true,
    "run_at": "document_idle"
  }],
  "action": {"default_popup": "popup.html", "default_title": "DOT"},
  "icons": {"128": "icon.png"},
  "key": ""
}
